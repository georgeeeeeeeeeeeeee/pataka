# Copy this file to .env and fill in your values

# Required: Your Anthropic API key for fit scoring and content generation
ANTHROPIC_API_KEY=sk-ant-...

# Flask secret key — change this to a random string
SECRET_KEY=change-this-to-a-long-random-string

# Database location (default: ./data/opportunity_agent.db)
DATABASE_URL=sqlite:///data/opportunity_agent.db

# Flask environment
FLASK_ENV=development
FLASK_DEBUG=0

# Port for the web UI (default: 5000)
PORT=5000

# Optional: override the Claude model used for scoring
# ANTHROPIC_MODEL=claude-opus-4-6
